          "name": "One-argument HAS advances one element after a successful sequence test",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["HAS",["SEQ",1,2]]],2]]]]]],
