{
  "version": 1,
  "name": "ALL in sequence and regex context",
  "desc": "Successor union constrained by minimum coverage of every argument, rather than intersection; continuation and exactness at each endpoint; zero-width and nested constraints; arrays and Unicode regexes; mode and function boundaries; capture merging, nearest eligible endpoints, earliest substructures, and duplicate names. Exact matches, anchors, and following terms distinguish successor endpoints. These portable cases prescribe neither alternative traversal order nor resource-counter totals.",
  "tests": [
    {
      "name": "Successor endpoints",
      "desc": "Exact matching, anchors, and following terms expose the complete successor set without requiring a particular traversal order.",
      "tests": [
        {
          "name": "Coverage example from the specification",
          "desc": "Exact matching checks every candidate final position, including rejected positions, to distinguish all permitted successor endpoints. Endpoints are the union with enough coverage for every argument, rather than an intersection or a filled interval. Permitted successor positions are 2, 3, 4, 7.",
          "tests": [
            {
              "name": "Final position 0",
              "input": [],
              "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["ANY",["SEQ",1],["SEQ",1,1,1],["SEQ",1,1,1,1,1,1,1]],["ANY",["SEQ",1,1],["SEQ",1,1,1,1]]]]]]]]],
              "errors": {"NO_MATCH":true}
            },
            {
              "name": "Final position 1",
              "input": [1],
              "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["ANY",["SEQ",1],["SEQ",1,1,1],["SEQ",1,1,1,1,1,1,1]],["ANY",["SEQ",1,1],["SEQ",1,1,1,1]]]]]]]]],
              "errors": {"NO_MATCH":true}
            },
            {
              "name": "Final position 2",
              "input": [1,1],
              "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["ANY",["SEQ",1],["SEQ",1,1,1],["SEQ",1,1,1,1,1,1,1]],["ANY",["SEQ",1,1],["SEQ",1,1,1,1]]]]]]]]],
