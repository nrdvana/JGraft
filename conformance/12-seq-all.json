          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["NODE","missing"]]]]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Intentional FAIL is a failed sequence probe",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["FAIL"]]]]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Syntax faults escape sequence probes",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",[[["SEQ",["ALL",["UNKNOWN"]]]]]]],
          "errors": {"INVALID_GRAFT":true}
        },
        {
          "name": "Requires a sequence argument",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",[[["SEQ",["ALL"]]]]]],
          "errors": {"INVALID_GRAFT":true}
        }
      ]
    },
    {
      "name": "Regex literals and Unicode",
      "desc": "STR supplies a virtual character array. Literals may span several codepoints, searches may be unanchored, valid surrogate pairs cannot be split, and combining marks remain separate.",
      "tests": [
        {
          "name": "Multi-character regex literal is a sequence",
          "input": "ab",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL","ab"],["END"]]]]],
          "output": "ab"
        },
        {
          "name": "Empty regex literal is an empty sequence",
          "input": "",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",""],["END"]]]]],
          "output": ""
        },
        {
          "name": "Virtual end element is absent",
          "input": "",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",["EXISTS"]],["END"]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Unanchored STR searches later positions",
          "input": "zabz",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["ALL","ab"]]]],
          "output": "zabz"
        },
        {
          "name": "Supplementary character is a single codepoint",
          "input": "😀",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",128512],["END"]]]]],
          "output": "😀"
        },
        {
          "name": "Partial surrogate does not match a valid pair",
          "input": "😀",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL","\ud83d"],["END"]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Lone surrogate behavior when preserved",
          "input": "\ud800",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",55296],["END"]]]]],
          "needLoneSurrogate": true,
          "output": "\ud800"
        },
        {
          "name": "Combining marks remain separate codepoints",
          "input": "é",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",["SEQ",101,769]],["END"]]]]],
          "output": "é"
        }
      ]
    },
    {
      "name": "Alternate targets",
      "desc": "One-argument HAS/IS probes advance exactly one element regardless of child width; alternate-target forms are zero-width assertions and use ordinary matching for their alternate targets.",
      "tests": [
        {
          "name": "Alternate-target HAS is a zero-width assertion",
          "desc": "Two-argument HAS changes the comparison target and therefore consumes no elements in sequence context.",
          "input": [9],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["HAS",1,1]],9]]]]]],
          "output": [9]
        },
        {
          "name": "Alternate-target IS is a zero-width assertion",
          "input": [9],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["IS",1,1]],9]]]]]],
          "output": [9]
        },
        {
          "name": "Alternate-target string uses ordinary matching",
          "input": "q",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",["IS","ab","ab"]],"q",["END"]]]]],
          "output": "q"
        }
      ]
    },
    {
      "name": "Continuation and nested constraints",
      "desc": "Each argument starts at the same cursor; output endpoints must cover every argument and remain available for following terms.",
      "tests": [
        {
          "name": "Continuation may require the shorter eligible endpoint",
          "input": [1,1,2],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",1],["ANY",["SEQ",1,1],["SEQ",1,1,1]]],2]]]]]],
          "output": [1,1,2]
        },
        {
          "name": "Continuation may require a longer eligible endpoint",
          "input": [1,1,1,2],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",1],["ANY",["SEQ",1,1],["SEQ",1,1,1]]],2]]]]]],
          "output": [1,1,1,2]
        },
        {
          "name": "Does not intersect unequal single successors",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",1],["SEQ",1,2]]]]]]]],
          "output": [1,2]
        },
        {
          "name": "Keeps all predicates anchored to the same start",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",[[["SEQ",["ALL",1,2]]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Cannot satisfy constraints by concatenating them",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",[[["SEQ",["ALL",["SEQ",1],["SEQ",2]]]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Failing ALL child eliminates the complete constraint",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",[[["SEQ",["ALL",1,["NODE","missing"]]]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Nested ALL combines its own successor coverage",
          "input": [1,1,1],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["ALL",["SEQ",1],["SEQ",1,1]],["SEQ",1,1,1]]]]]]]],
          "output": [1,1,1]
        },
        {
          "name": "Of zero-width assertions does not consume data",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["START"],["NONE",2]],1]]]]]],
          "output": [1]
        },
        {
          "name": "Unions Unicode endpoints without UTF-16 splitting",
          "input": "😀a",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL","😀","😀a"],["END"]]]]],
          "output": "😀a"
        },
        {
          "name": "Regex constrains content as well as width",
          "input": "abc",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL","a","abd"],["END"]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Regex can have a zero-width lookahead argument",
          "input": "abc",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",["NONE","z"],"abc"],["END"]]]]],
          "output": "abc"
        }
      ]
    },
    {
      "name": "Captures",
      "desc": "ALL retains captures from each successful structural argument. Sequence constraints contribute captures from their nearest endpoint at or before the output; ties within an argument select the earliest substructure. Names must be unique after integer coercion, arbitrary property names are preserved, and capture-name evaluation sees NODE as missing. SEQMIN/SEQMAX and CAP expose these results.",
      "tests": [
        {
          "name": "Merges captures from unequal-width structural arguments",
          "input": [{"a":[1]},{"b":[2]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",{"a":[[["SEQMAX","A",1]]]}],["SEQ",["EXISTS"],{"b":[[["SEQMIN","B",2]]]}]]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {"A":{"path":[0,"a"],"ofs":0,"len":1,"lim":1},"B":{"path":[1,"b"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "Capture merging is independent of argument order",
          "input": [{"a":[1]},{"b":[2]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",["EXISTS"],{"b":[[["SEQMIN","B",2]]]}],["SEQ",{"a":[[["SEQMAX","A",1]]]}]]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {"A":{"path":[0,"a"],"ofs":0,"len":1,"lim":1},"B":{"path":[1,"b"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "Chooses the nearest eligible capture endpoint for each argument",
          "input": [{"x":[1]},{"x":[2]},{"y":[3]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",["REP",0,1,["EXISTS"]],{"x":[[["SEQMAX","A",["EXISTS"]]]]}],["SEQ",["EXISTS"],["EXISTS"],{"y":[[["SEQMAX","B",["EXISTS"]]]]}]]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {"A":{"path":[1,"x"],"ofs":0,"len":1,"lim":1},"B":{"path":[2,"y"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "Does not take captures beyond output endpoint 2",
          "input": [{"x":[1]},{"y":[2]},{"x":[3]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",["REP",0,2,["EXISTS"]],{"x":[[["SEQMAX","A",["EXISTS"]]]]}],["SEQ",["EXISTS"],{"y":[[["SEQMAX","B",["EXISTS"]]]]}]],["EXISTS"]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {"A":{"path":[0,"x"],"ofs":0,"len":1,"lim":1},"B":{"path":[1,"y"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "Does not take captures beyond output endpoint 3",
          "input": [{"x":[1]},{"y":[2]},{"x":[3]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",["REP",0,2,["EXISTS"]],{"x":[[["SEQMAX","A",["EXISTS"]]]]}],["SEQ",["EXISTS"],{"y":[[["SEQMAX","B",["EXISTS"]]]]}]]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {"A":{"path":[2,"x"],"ofs":0,"len":1,"lim":1},"B":{"path":[1,"y"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "Rejects duplicate names when merging captures",
          "input": [{"a":[1]},{"b":[2]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",{"a":[[["SEQMAX","same",1]]]}],["SEQ",["EXISTS"],{"b":[[["SEQMAX","same",2]]]}]]]]]],["COPY",["CAP"],["NODE"]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true},
          "desc": "Reading CAP makes capture names and conflicts observable; boolean-only matching must not bypass this check."
        },
        {
          "name": "Enclosing ANY suppresses captures and duplicate-name conflicts in ALL",
          "input": [{"a":[1]},{"b":[2]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["ANY",["IS",[[["SEQ",["ALL",["SEQ",{"a":[[["SEQMAX","same",1]]]}],["SEQ",["EXISTS"],{"b":[[["SEQMAX","same",2]]]}]]]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {}
        },
        {
          "name": "Retains zero-length captures from a satisfied shorter constraint",
          "input": [{"a":[]},{"b":[2]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",{"a":[[["SEQMAX","empty"]]]}],["SEQ",["EXISTS"],{"b":[[["SEQMAX","other",2]]]}]]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {"empty":{"path":[0,"a"],"ofs":0,"len":0,"lim":0},"other":{"path":[1,"b"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "Merges arbitrary capture names including __proto__",
          "input": [{"a":[1]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",{"a":[[["SEQMAX","__proto__",1]]]}]]]]],["COPY",["CAP"],["NODE"]]]],
          "needProto": true,
          "output": {"__proto__":{"path":[0,"a"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "Capture name uniqueness applies after integer coercion",
          "input": [{"a":[1]},{"b":[2]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",{"a":[[["SEQMAX",1,1]]]}],["SEQ",["EXISTS"],{"b":[[["SEQMAX","1",2]]]}]]]]]],["COPY",["CAP"],["NODE"]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true},
          "desc": "Reading CAP makes capture names and conflicts observable; boolean-only matching must not bypass this check."
        }
      ]
    },
    {
      "name": "Logical composition",
      "desc": "Check empty argument lists, nested expressions, ordinary-element behavior, and successful or failing continuations.",
      "tests": [
        {
          "name": "Resolves equal-endpoint substructures by earliest match",
          "input": [{"x":[1]},{"x":[2]}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ",["REP",0,1,["EXISTS"]],{"x":[[["SEQMAX","A",["EXISTS"]]]]},["REP",0,1,["EXISTS"]]],["SEQ"],["SEQ",["EXISTS"],["EXISTS"]]]]]]],["COPY",["CAP"],["NODE"]]]],
          "output": {"A":{"path":[0,"x"],"ofs":0,"len":1,"lim":1}}
        },
        {
          "name": "An explicit IS child overrides partial structural matching",
          "input": [{"a":1,"b":2}],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",[[["SEQ",["ALL",["IS",{"a":1}]]]]]]],
          "errors": {"NO_MATCH":true}
        },
        {
          "name": "Cannot satisfy a nonempty constraint at the end",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["SEQ"],1]]]]]]],
          "errors": {"NO_MATCH":true}
        }
      ]
    },
    {
      "name": "Errors and restrictions",
      "desc": "Runtime INVALID_TARGET and INVALID_OPERAND faults are failed match probes. Static INVALID_GRAFT is permitted where specified, including unreachable syntax faults; intentional FAIL is not upgraded.",
      "tests": [
        {
          "name": "SEQ initiation restriction applies after EXPR expansion",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1,"expr":["p",["SEQ",1]]},["MATCH",[[["ALL",["EXPR","p"]]]]]],
          "errors": {"INVALID_GRAFT":true}
        },
        {
          "name": "Invalid regex literal: null",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",null],["END"]]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true}
        },
        {
          "name": "Invalid regex literal: boolean",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",true],["END"]]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true}
        },
        {
          "name": "Invalid regex literal: negative number",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",-1],["END"]]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true}
        },
        {
          "name": "Invalid regex literal: fraction",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",0.5],["END"]]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true}
        },
        {
          "name": "Invalid regex literal: object",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",{}],["END"]]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true}
        },
        {
          "name": "Invalid regex literal: escaped array",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["STR",["SEQ",["START"],["ALL",[[97]]],["END"]]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true}
        },
        {
          "name": "A reference-produced array is not reinterpreted as regex syntax",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1,"const":["p",[["SEQ",97]]]},["MATCH",["STR",["SEQ",["START"],["ALL",["CONST","p"]],["END"]]]]],
          "errors": {"NO_MATCH":true,"INVALID_GRAFT":true}
        }
      ]
    },
    {
      "name": "HAS and IS assertions",
      "desc": "One-argument HAS/IS probes advance exactly one element regardless of child width; alternate-target forms are zero-width assertions and use ordinary matching for their alternate targets.",
      "tests": [
        {
          "name": "One-argument IS advances one element after a successful sequence test",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["MATCH",["IS",[[["SEQ",["ALL",["IS",["SEQ",1,2]]],2]]]]]],
          "output": [1,2]
