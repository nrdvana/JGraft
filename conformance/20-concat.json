{
  "version": 1,
  "name": "CONCAT",
  "desc": "Covers the CONCAT expression for homogeneous strings and arrays: one or more operands, value-context evaluation, Unicode boundaries, non-flattening array concatenation, independent constructed values, scopes and references, pending MOVE deletions, SPLIT origin and adjacent-element metadata, errors, and resource failures. Expectations follow the specification independently of implementation behavior.",
  "tests": [
    {
      "name": "Strings",
      "desc": "Operands are evaluated in value context and joined verbatim. Empty strings are identities; no separators, normalization, or scalar coercion are implied.",
      "tests": [
        {
          "name": "Single empty operand",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",""],["NODE"]]],
          "output": ""
        },
        {
          "name": "Two empty operands",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",""],["NODE"]]],
          "output": ""
        },
        {
          "name": "Single nonempty operand",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","abc"],["NODE"]]],
          "output": "abc"
        },
        {
          "name": "Two nonempty operands",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","a","b"],["NODE"]]],
          "output": "ab"
        },
        {
          "name": "Empty prefix and suffix",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","","a",""],["NODE"]]],
          "output": "a"
        },
        {
          "name": "Interior empty operand",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","ab","","cd","ef"],["NODE"]]],
          "output": "abcdef"
        },
        {
          "name": "Repeated operands",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","a","a","a"],["NODE"]]],
          "output": "aaa"
        },
        {
          "name": "Control characters",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","\u0000","\n","\r\t"],["NODE"]]],
          "output": "\u0000\n\r\t"
        },
        {
          "name": "Composed and decomposed Unicode",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","é","é"],["NODE"]]],
          "output": "éé"
        },
        {
          "name": "Non-Latin and astral characters",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","中","文","🙂"],["NODE"]]],
          "output": "中文🙂"
        },
        {
          "name": "Multiple astral characters",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","🙂","x","𝄞"],["NODE"]]],
          "output": "🙂x𝄞"
        },
        {
          "name": "Property-like strings",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","__proto__","constructor","toString"],["NODE"]]],
          "output": "__proto__constructortoString"
        },
        {
          "name": "Lone surrogate operands 1",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","\ud83d","\ude42"],["NODE"]]],
          "output": "🙂",
          "needLoneSurrogate": true
        },
        {
          "name": "Lone surrogate operands 2",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","\ud83d","x","\ude42"],["NODE"]]],
          "output": "\ud83dx\ude42",
          "needLoneSurrogate": true
        },
        {
          "name": "Lone surrogate operands 3",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","\ud800","\ud800"],["NODE"]]],
          "output": "\ud800\ud800",
          "needLoneSurrogate": true
        },
        {
          "name": "Lone surrogate operands 4",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","\udc00","\ud800"],["NODE"]]],
          "output": "\udc00\ud800",
          "needLoneSurrogate": true
        },
        {
          "name": "Codepoint length after a pair forms",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH",["CONCAT","\ud83d","\ude42"]],["NODE"]]],
          "output": 1,
          "needLoneSurrogate": true
        },
        {
          "name": "Codepoint slice across operands",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SLICE",["CONCAT","a🙂","𝄞b"],1,2],["NODE"]]],
          "output": "🙂𝄞"
        },
        {
          "name": "Numeric expression identifier",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",[58,"ab","cd"],["NODE"]]],
          "output": "abcd"
        }
      ]
    },
    {
      "name": "Arrays",
      "desc": "A new combined array contains each source element in order, including nested arrays as single elements. Empty arrays are identities. Objects and arrays inside operands are value expressions when constructed literally.",
      "tests": [
        {
          "name": "Single empty array",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]]],["NODE"]]],
          "output": []
        },
        {
          "name": "Two empty arrays",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],[[]]],["NODE"]]],
          "output": []
        },
        {
          "name": "Single scalar element",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[1]]],["NODE"]]],
          "output": [1]
        },
        {
          "name": "Two scalar spans",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[1]],[[2]]],["NODE"]]],
          "output": [1,2]
        },
        {
          "name": "Empty middle span",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[1,2]],[[]],[[3,4]]],["NODE"]]],
          "output": [1,2,3,4]
        },
        {
          "name": "Falsey elements",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],[[null,false,0,""]],[[]]],["NODE"]]],
          "output": [null,false,0,""]
        },
        {
          "name": "Nested arrays stay elements",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[[[1,2]]]],[[[[3]]]]],["NODE"]]],
          "output": [[1,2],[3]]
        },
        {
          "name": "Objects and empty arrays",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[{"a":[[1]]},[[]]]],[[{"b":null},[[false]]]]],["NODE"]]],
          "output": [{"a":[1]},[],{"b":null},[false]]
        },
        {
          "name": "One-level flattening",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[[[[[1]]]],[[]]]],[[[[2]]]]],["NODE"]]],
          "output": [[[1]],[],[2]]
        },
        {
          "name": "Array values evaluate expressions",
          "input": 4,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[["NODE"],["CASTSTR"],{"n":["NODE"]}]],[[["BOOL"],["NUM"]]]],["NODE"]]],
          "output": [4,"4",{"n":4},false,true]
        },
        {
          "name": "Repeated reference contributes repeated spans",
          "input": [{"x":1},[2]],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"],["NODE"]],["NODE"]]],
          "output": [{"x":1},[2],{"x":1},[2]]
        },
        {
          "name": "One array numeric identifier",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",[58,["NODE"]],["NODE"]]],
          "output": [1,2]
        },
        {
          "name": "Referenced expression-looking elements remain data",
          "input": [["FAIL"],{"x":["NODE"]}],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"],[[]]],["NODE"]]],
          "output": [["FAIL"],{"x":["NODE"]}]
        }
      ]
    },
    {
      "name": "Operand types",
      "desc": "Only arrays or only strings are accepted, including for the one-operand form. A later empty operand does not change its type. Invalid dynamic values produce INVALID_TARGET.",
      "tests": [
        {
          "name": "Scalar or object: null",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: null",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: null",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Scalar or object: boolean false",
          "input": false,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: boolean false",
          "input": false,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: boolean false",
          "input": false,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Scalar or object: boolean true",
          "input": true,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: boolean true",
          "input": true,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: boolean true",
          "input": true,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Scalar or object: number 0",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: number 0",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: number 0",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Scalar or object: number 1",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: number 1",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: number 1",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Scalar or object: number -2",
          "input": -2,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: number -2",
          "input": -2,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: number -2",
          "input": -2,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Scalar or object: empty object",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: empty object",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: empty object",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Scalar or object: populated object",
          "input": {"a":1},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After a string: populated object",
          "input": {"a":1},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "After an array: populated object",
          "input": {"a":1},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],["NODE"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Mixed string and array 1",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",[[]]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Mixed string and array 2",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[]],""],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Mixed string and array 3",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","a",[["b"]]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Mixed string and array 4",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[["a"]],"b"],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Parsed dates are not strings",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["CASTDATE","2024-01-01"]],["NODE"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Explicit date stringification",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["CASTSTR",["CASTDATE","2024-01-01"]],"!"],["NODE"]]],
          "output": "2024-01-01!"
        }
      ]
    },
    {
      "name": "Contexts and independence",
      "desc": "All operands use the same caller current node. Functions resolve to literal constructed values under matching; source arrays and namespace values remain available after concatenation and subsequent edits.",
      "tests": [
        {
          "name": "Current-node operands",
          "input": "x",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"],"/",["NODE"]],["NODE"]]],
          "output": "x/x"
        },
        {
          "name": "Computed reference paths",
          "input": {"which":"value","value":"x"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE",["NODE","which"]],["NODE","value"]],["NODE"]]],
          "output": "xx"
        },
        {
          "name": "CONST STASH TEMP and EXPR",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1,"const":["x","const"],"expr":["x",["CONCAT","ex","pr"]]},["COPY","stash",["STASH","x"]],["COPY",["LOCAL","x","temp",["CONCAT",["CONST","x"],["STASH","x"],["TEMP","x"],["EXPR","x"]]],["NODE"]]],
          "output": "conststashtempexpr"
        },
        {
          "name": "LOCAL rebinds all operands",
          "input": {"x":"outer"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOCAL",null,{"x":"inner"},["CONCAT",["NODE","x"],["NODE","x"]]],["NODE"]]],
          "output": "innerinner"
        },
        {
          "name": "Match expression operands are values",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[["ARRAY"]]],[[["IS",[[1]]]]]],["NODE"]]],
          "output": [true,true]
        },
        {
          "name": "HAS sees the literal function result",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["HAS",["CONCAT",[[1]],[[2]]]],["NODE"]]],
          "output": true
        },
        {
          "name": "IS requires the complete function result",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",["CONCAT",[[1]],[[2]]]],["NODE"]]],
          "output": false
        },
        {
          "name": "Editing result cannot edit input",
          "input": {"source":[{"x":1}]},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE","source"],["NODE","source"]],"result"],["COPY",2,["NODE","result",0,"x"]]],
          "output": {"source":[{"x":1}],"result":[{"x":2},{"x":1}]}
        },
        {
          "name": "Editing result cannot edit stash",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",[[{"x":1}]],["STASH","a"]],["COPY",["CONCAT",["STASH","a"]],["STASH","b"]],["COPY",2,["STASH","b",0,"x"]],["COPY",{"a":["STASH","a"],"b":["STASH","b"]},["NODE"]]],
          "output": {"a":[{"x":1}],"b":[{"x":2}]}
        },
        {
          "name": "Pending deletions prevent full enumeration",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["MOVE",0,null,["NODE",["LENGTH",["CONCAT",["NODE"]]]],["STASH","result"]]],
          "errors": {"INVALID_TARGET":true}
        },
        {
          "name": "Span avoiding a pending deletion",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["MOVE",0,null,1,["STASH",["CASTSTR",["LENGTH",["CONCAT",["SLICE",["NODE"],1],[[4]]]]]]],["COPY",["STASH","3"],["NODE"]]],
          "output": 2
        },
        {
          "name": "Regex context uses the resulting string literally",
          "input": "ab",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",["STR",["CONCAT","a","b"]]],["NODE"]]],
          "output": true
        },
        {
          "name": "Parsed date elements export as strings",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[["CASTDATE","2024-01-01"]]],[[["CASTDATE","2024-01-02"]]]],["NODE"]]],
          "output": ["2024-01-01","2024-01-02"]
        },
        {
          "name": "Inner scope restores outer bindings",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1,"const":["x","outer"]},["JGRAFT",{"const":["x","inner"]},["COPY",["CONCAT",["CONST","x"],"!"],["STASH","unused"]]],["COPY",["CONCAT",["CONST","x"],"!"],["NODE"]]],
          "output": "outer!"
        }
      ]
    },
    {
      "name": "SPLIT metadata",
      "desc": "The first input carrying SPLIT metadata selects the origin. Matching origins retain each element separator and trim; other elements inherit adjacent metadata in final order. Empty results drop metadata. JOIN observes the metadata without exposing implementation storage.",
      "tests": [
        {
          "name": "Single source round trip",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "]]],["NODE"]]],
          "output": " a : b|c "
        },
        {
          "name": "Unannotated prefix receives following separator",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",[["x"]],["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "]]],["NODE"]]],
          "output": "x: a : b|c "
        },
        {
          "name": "Unannotated suffix inherits left trim and separator",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "],[["x","y"]]]],["NODE"]]],
          "output": " a : b|c |x|y"
        },
        {
          "name": "Plain empty operands retain metadata",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",[[]],["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "],[[]]]],["NODE"]]],
          "output": " a : b|c "
        },
        {
          "name": "Reordered spans retain one origin",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1,"const":["s",["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "]]},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",["SLICE",["CONST","s"],2,1],["SLICE",["CONST","s"],0,1],["SLICE",["CONST","s"],1,1]]],["NODE"]]],
          "output": "c | a : b"
        },
        {
          "name": "Same-origin insertion retains source trim",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1,"const":["s",["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "]]},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",["SLICE",["CONST","s"],0,1],["SLICE",["CONST","s"],0,1],["SLICE",["CONST","s"],1,2]]],["NODE"]]],
          "output": " a : a : b|c "
        },
        {
          "name": "Foreign origin receives adjacent metadata",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "],["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," d|e "]]],["NODE"]]],
          "output": " a : b|c |d|e"
        },
        {
          "name": "First origin wins even after plain prefix",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["JOIN",{"sep":["ANY",":","|"],"default":"/"},["CONCAT",[["x"]],["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," a : b|c "],["SPLIT",{"sep":["ANY",":","|"],"default":"/","trim":" "}," d|e "]]],["NODE"]]],
          "output": "x: a : b|c |d|e"
        },
