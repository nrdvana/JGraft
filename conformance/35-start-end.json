{
  "version": 1,
  "name": "START and END",
  "desc": "Covers START and END as ordinary match/value expressions and as zero-width assertions in array sequence and string regex contexts. Tests distinguish node location from node value, first elements from the nonexistent end element, absolute cursors from subexpression boundaries, empty subjects, Unicode positions, namespace/scope restoration, composition, numeric IDs, and validation.",
  "tests": [
    {
      "name": "Ordinary node locations",
      "desc": "Outside sequence context, anchors inspect the immediate containing array. START tests index zero even for the missing element of an empty array; END tests the nonexistent element at array length. The root itself and object properties are neither. Results do not depend on the element value. Missing nodes are probed by structural patterns because AT itself requires an existing node.",
      "tests": [
        {
          "name": "START at root null",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["START"],["NODE"]]],
          "output": false
        },
        {
          "name": "START at root false",
          "input": false,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["START"],["NODE"]]],
          "output": false
        },
        {
          "name": "START at root true",
          "input": true,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["START"],["NODE"]]],
          "output": false
        },
        {
          "name": "START at root number",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["START"],["NODE"]]],
          "output": false
        },
        {
          "name": "START at root string",
          "input": "abc",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["START"],["NODE"]]],
          "output": false
        },
        {
          "name": "START at root array",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["START"],["NODE"]]],
          "output": false
        },
