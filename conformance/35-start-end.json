          "jgraft": ["JGRAFT",{"v":1},["COPY",["START"],["NODE"]]],
          "output": false
        },
        {
          "name": "START length 0 index 0",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["HAS",[[["IS",["START"],true]]]],["NODE"]]],
          "output": true
        },
        {
          "name": "START length 1 index 0",
          "input": [10],
          "jgraft": ["JGRAFT",{"v":1},["AT",["NODE",0],["COPY",["START"],["STASH","result"]]],["COPY",["STASH","result"],["NODE"]]],
          "output": true
